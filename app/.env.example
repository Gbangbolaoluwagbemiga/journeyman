# ─── Frontend environment variables ─────────────────────────────────────────
# Copy this file to .env and fill in the values.

# Arbitrum Sepolia Configuration
VITE_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
VITE_CHAIN_ID=421614
VITE_EXPLORER_URL=https://sepolia.arbiscan.io

# The Journeyman proxy. This is the live one on Arbitrum Sepolia — the value
# here used to be 0x6142bf48…, a pre-ETHOnline contract on a different chain,
# so anyone copying this file pointed the app at something that does not exist
# and got an empty marketplace rather than an error.
VITE_JOURNEYMAN_CONTRACT_ADDRESS=0x5128B3E2a20d483f68834b26505aFD7457C282dc

# Circle USDC on Arbitrum Sepolia (official, 6 decimals)
VITE_USDC_TOKEN_CONTRACT=0x75faf114eafb1BDbe2F0316DF893fd58CE46AA4d

# Reown (WalletConnect) Project ID
VITE_REOWN_PROJECT_ID=your_project_id_here

# Backend API (set to your deployed API URL in production)
VITE_API_URL=http://localhost:8787
VITE_API_SECRET=change-me-in-production

# Groq AI Configuration (for milestone generation)
GROQ_API_KEY=your_groq_api_key_here
# llama-3.3-70b-versatile was decommissioned by Groq on 2026-08-16. Anything
# still defaulting to it fails closed with no served model.
GROQ_MODEL=openai/gpt-oss-120b

# Brave Search API (for AI features)
BRAVE_SEARCH_API_KEY=your_brave_api_key_here

# Patron daemon — Autopilot's brain. Left blank, Journeyman runs SecureFlow-only
# and the Autopilot surfaces disable themselves rather than erroring.
VITE_AGENT_API_URL=

# Telegram bot handle for the worker front door. Blank hides the card.
VITE_TELEGRAM_BOT=

# Google OAuth client id (Web application). Blank disables managed sign-up.
VITE_GOOGLE_CLIENT_ID=

# The Graph — Subgraph Studio endpoint the app reads job and application state
# from. LEAVE IT BLANK until you have a real one: blank falls back to direct RPC
# reads, which work and are only slower, whereas a placeholder or a URL indexing
# a different contract renders a board full of escrows that do not exist.
VITE_GRAPH_URL=
