# ─── Backend API environment variables ───────────────────────────────────────
# Copy this file to backend/.env and fill in the values.

# API secret (must match VITE_API_SECRET in the frontend)
API_SECRET=change-me-in-production

# Port (default 8787)
PORT=8787

# Frontend origin (for CORS) — use your deployed URL in production
FRONTEND_URL=http://localhost:5173

# ─── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_PROJECT_ID=your-project-id
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Groq AI ─────────────────────────────────────────────────────────────────
GROQ_API_KEY=your-groq-api-key
# llama-3.3-70b-versatile was decommissioned by Groq on 2026-08-16.
GROQ_MODEL=openai/gpt-oss-120b

# ─── Chain ───────────────────────────────────────────────────────────────────
# JSON-RPC endpoint. Optional: defaults to Arbitrum Sepolia's public RPC.
# The old ARC_RPC_URL is deliberately NOT read — a stale one left set in a
# deployed environment would keep the API reading a chain nothing is on.
ARB_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# The Journeyman proxy on Arbitrum Sepolia. Optional: this is the default.
CONTRACT_ADDRESS=0x5128B3E2a20d483f68834b26505aFD7457C282dc

# ─── Gasless relay (EIP-2771) ─────────────────────────────────────────────────
# Private key of the funded relayer wallet (pays gas on behalf of users)
RELAYER_PRIVATE_KEY=0x

# Deployed MinimalForwarder contract address (optional)
TRUSTED_FORWARDER_ADDRESS=
