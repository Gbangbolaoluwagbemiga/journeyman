blob-report/
.playwright/

# Patron daemon's local SQLite — machine-local demo state, never shared
agent/daemon/data/

# Submission screenshots — regenerate with playwright.shots.config.ts
submission-shots/

# Regenerated by `graph codegen` from schema.graphql and the ABI. Committing it
# means a stale copy can disagree with the schema it claims to describe.
subgraph/generated/
