[submodule "app/contracts/solidity/lib/v4-core"]
	path = app/contracts/solidity/lib/v4-core
	url = https://github.com/Uniswap/v4-core
[submodule "app/contracts/solidity/lib/forge-std"]
	path = app/contracts/solidity/lib/forge-std
	url = https://github.com/foundry-rs/forge-std
[submodule "app/contracts/solidity/lib/openzeppelin-contracts"]
	path = app/contracts/solidity/lib/openzeppelin-contracts
	url = https://github.com/OpenZeppelin/openzeppelin-contracts
[submodule "app/contracts/solidity/lib/openzeppelin-contracts-upgradeable"]
	path = app/contracts/solidity/lib/openzeppelin-contracts-upgradeable
	url = https://github.com/OpenZeppelin/openzeppelin-contracts-upgradeable
