# Patron daemon — server-side secrets only. NEVER prefix with VITE_, NEVER ship to the browser.

# Anthropic (Claude) — brief generation, application scoring, work review
ANTHROPIC_API_KEY=

# Groq — currently the ACTIVE provider (see daemon/src/groq/structured.ts). Used
# while the Anthropic account has no credit balance; same zod schemas either way.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant

# Arc Testnet
# Reads. drpc answers these under load; it caps eth_getLogs somewhere under
# 200 blocks (its own error claims 10000, which is not true — measure, don't
# read the message).
ARC_RPC_URL=https://rpc.drpc.testnet.arc.network
# eth_getLogs only, which is the one thing drpc will not do. This endpoint
# rate-limits a bare eth_call under ordinary use, so keeping reads off it is
# the difference between a dashboard that loads and one that shows a dash.
ARC_LOG_RPC_URL=https://rpc.testnet.arc.network
ARC_CHAIN_ID=5042002

# SecureFlow — Patron calls this contract, does NOT deploy its own
ATELIER_CONTRACT_ADDRESS=0x6142bf4855D4F9dbC1cD8109377d4F4E2AF1ab59
USDC_ADDRESS=0x3600000000000000000000000000000000000000
GRAPH_URL=https://api.goldsky.com/api/public/project_cmpyopkeb3cxh01v51s4wg5nc/subgraphs/secureflow/v3/gn

# Circle Programmable Wallets (MPC) — the Patron Agent Wallet.
# Reuses the SAME Circle account (API key + entity secret) as Foreman, but a
# DEDICATED wallet — run `npm run circle:setup` to provision it (see
# daemon/src/circle/wallet-setup.ts). Never commit these.
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
# Running a daemon locally while one is deployed? Give this one its OWN wallet:
#   npm run circle:dev-wallet
# Two daemons on one CIRCLE_WALLET_ID are the same agent on-chain, both polling
# the same jobs, neither able to see what the other already did — the dedup
# markers live in each daemon's own SQLite. One escrow's single applicant was
# scored 25 by one and 70 by the other, and the 70 hired them.
CIRCLE_WALLET_ID=
CIRCLE_WALLET_ADDRESS=
CIRCLE_BLOCKCHAIN=ARC-TESTNET

# Circle Gateway (x402 nanopayments — both sell side and buy side)
GATEWAY_FACILITATOR_URL=https://gateway-api-testnet.circle.com
X402_ORDER_FEE=0.05

# x402 BUY side — Patron pays this service to verify the leading applicant's
# portfolio before hiring (see services/portfolio-check/). Unset = skip verification.
PORTFOLIO_CHECK_URL=http://localhost:8788

# Application-level spending policy — the "second cage" (Agent Wallet has no
# native policy engine via the Developer-Controlled Wallets SDK, so Patron
# enforces caps itself before every signed spend)
DAILY_SPEND_CAP_USDC=50
X402_BUY_SPEND_CAP_USDC=5

PORT=8787

# ── Managed-worker layer (the human front door) ──────────────────────────────
# All worker wallets live in one Circle wallet set. The first signup creates it
# and logs the id — paste it here so restarts reuse the same set.
WORKER_WALLET_SET_ID=
# Gas handed to a new worker so their first application can be signed. On Arc the
# native currency IS USDC, so this doubles as their first earnings balance.
WORKER_SIGNUP_GAS_USDC=0.05
# Optional second surface. Unset = the bot is dormant and nothing else changes.
# Leave BLANK on a local daemon when a hosted one has the same token. Telegram
# allows one long-poller per bot, so the second steals updates from the first
# and both log "Conflict: terminated by other getUpdates". The daemon runs
# identically without it.
TELEGRAM_BOT_TOKEN=
# Where Atelier is served. Every link the bot sends into a chat is built from
# this, so a wrong value silently sends freelancers to the wrong app.
PUBLIC_APP_URL=http://localhost:5173

# Google OAuth client id, used to verify sign-in tokens.
GOOGLE_CLIENT_ID=

# LOCAL SEEDING ONLY — never set these on a deployed daemon.
#
# scripts/seed-freelancers.ts signs applications as these accounts so a local
# board has somebody on it. They are raw private keys: they belong on a laptop
# and nowhere else, and the daemon itself never reads them.
FREELANCER_1_KEY=
FREELANCER_2_KEY=
FREELANCER_3_KEY=

# ── In-app notifications ────────────────────────────────────────────────────
# BOTH of these, or the bell never rings. They fail in the two quietest ways
# a dependency can: with API_URL blank, post() returns before sending
# anything; with API_SECRET wrong, every POST comes back 401. Neither used to
# say a word, and the only symptom of either is that nobody is told they were
# hired, reviewed or paid — while everything on-chain works perfectly.
# API_SECRET must be byte-identical to the backend's.
API_URL=
API_SECRET=
